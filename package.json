{
  "name": "@moonstar-x/logger",
  "version": "2.0.0",
  "description": "A tiny, zero-dependency logger for Node.js with levels, colors, timestamps, child loggers and JSON output.",
  "scripts": {
    "build": "tsc",
    "clean": "tsc --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prebuild": "npm run clean",
    "prepack": "npm run build"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "log",
    "logger",
    "logging",
    "colors",
    "colored logging",
    "color logs",
    "ansi",
    "console",
    "json logging",
    "structured logging",
    "log level",
    "child logger",
    "zero dependencies",
    "typescript"
  ],
  "license": "MIT",
  "author": "moonstar-x <christian.lopez99@outlook.com>",
  "homepage": "https://github.com/moonstar-x-libs/node-logger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonstar-x-libs/node-logger.git"
  },
  "bugs": {
    "url": "https://github.com/moonstar-x-libs/node-logger/issues"
  },
  "devDependencies": {
    "@moonstar-x/eslint-config": "^2.0.0",
    "@moonstar-x/tsconfig": "^1.0.1",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "typescript": "^7.0.2"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
